# 환경변수 예시 파일입니다. 실제 값은 .env.local에 채워넣으세요 (.env.local은 .gitignore로 제외됩니다).
# Vercel Preview/Production에서는 이 파일을 올리지 말고, 서비스가 제공한 pooled PostgreSQL
# 연결 문자열을 Vercel 프로젝트의 DATABASE_URL로 설정하세요. 실제 URL·키·비밀번호는 절대 커밋하지 않습니다.
# 문서: docs/12-privacy-security-compliance.md#secret-관리, README.md#환경-변수-이름

# 앱 런타임 연결 문자열. 로컬에서는 개발 DB, Vercel에서는 관리형 DB의 pooled URL을 사용합니다.
# 로컬 Homebrew Postgres 기본값 예시:
DATABASE_URL="postgresql://YOUR_OS_USER@localhost:5432/gemstonecurator_dev"
# Vitest 통합 테스트 전용 별도 DB. vitest.setup.ts가 테스트 실행 중 DATABASE_URL로 대체합니다.
DATABASE_URL_TEST="postgresql://YOUR_OS_USER@localhost:5432/gemstonecurator_test"
# prisma migrate diff/dev 전용 shadow DB (createdb gemstonecurator_shadow로 생성)
SHADOW_DATABASE_URL="postgresql://YOUR_OS_USER@localhost:5432/gemstonecurator_shadow"
# 선택 사항: prisma migrate deploy 같은 CLI migration에서 우선 사용할 관리형 DB의 direct URL.
# 미설정 시 prisma.config.ts는 DATABASE_URL을 사용하므로 기존 로컬 개발 흐름은 바뀌지 않습니다.
# Vercel 런타임에는 DATABASE_URL만 필요합니다.
DIRECT_DATABASE_URL=""

# Phase 2: 생년월일시 등 민감 필드 envelope encryption KEK (32바이트를 base64로, 직접 생성)
ENCRYPTION_KEK=""

# 세션/공유 토큰 해시에 사용하는 pepper (임의의 긴 무작위 문자열로 직접 생성하세요)
SESSION_TOKEN_PEPPER=""

# OpenAI 연동 (docs/09-ai-prompts-and-safety.md)
OPENAI_API_KEY=""
# 실제 사용 가능한 모델명을 OpenAI 계정 기준으로 직접 지정하세요. 기본값을 임의로 정하지 않습니다.
OPENAI_MODEL=""
# 추론 모델(GPT-5 계열 등) 사용 시 권장: minimal 또는 low. 생략 가능(비추론 모델에는 미전달).
OPENAI_REASONING_EFFORT=""
